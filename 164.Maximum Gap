Given an integer array nums, return the maximum difference between two successive elements in its sorted form. If the array contains less than two elements, return 0.

You must write an algorithm that runs in linear time and uses linear extra space.

 

Example 1:

Input: nums = [3,6,9,1]
Output: 3
Explanation: The sorted form of the array is [1,3,6,9], either (3,6) or (6,9) has the maximum difference 3.
Example 2:

Input: nums = [10]
Output: 0
Explanation: The array contains less than 2 elements, therefore return 0.
 

Constraints:

1 <= nums.length <= 105
0 <= nums[i] <= 109


package main

import "fmt"

func maximumGap(nums []int) int {
	n := len(nums)
	if n < 2 {
		return 0
	}

	mn, mx := nums[0], nums[0]
	for _, num := range nums {
		if num < mn {
			mn = num
		}
		if num > mx {
			mx = num
		}
	}

	if mn == mx {
		return 0 // все элементы одинаковые
	}

	// Размер и количество корзин
	bucketSize := max(1, (mx-mn)/(n-1))
	bucketCount := (mx-mn)/bucketSize + 1

	bucketMin := make([]int, bucketCount)
	bucketMax := make([]int, bucketCount)
	hasValue := make([]bool, bucketCount)

	for _, num := range nums {
		idx := (num - mn) / bucketSize
		if !hasValue[idx] {
			bucketMin[idx] = num
			bucketMax[idx] = num
			hasValue[idx] = true
		} else {
			if num < bucketMin[idx] {
				bucketMin[idx] = num
			}
			if num > bucketMax[idx] {
				bucketMax[idx] = num
			}
		}
	}

	result := 0
	prevMax := mn

	for i := 0; i < bucketCount; i++ {
		if !hasValue[i] {
			continue
		}
		if gap := bucketMin[i] - prevMax; gap > result {
			result = gap
		}
		prevMax = bucketMax[i]
	}

	return result
}

func max(a, b int) int {
	if a > b {
		return a
	}
	return b
}

func main() {
	fmt.Println(maximumGap([]int{3, 6, 9, 1})) // 3
	fmt.Println(maximumGap([]int{10}))         // 0
}

There are n servers numbered from 0 to n - 1 connected by undirected server-to-server connections forming a network where connections[i] = [ai, bi] represents a connection between servers ai and bi. Any server can reach other servers directly or indirectly through the network.

A critical connection is a connection that, if removed, will make some servers unable to reach some other server.

Return all critical connections in the network in any order.

 

Example 1:


Input: n = 4, connections = [[0,1],[1,2],[2,0],[1,3]]
Output: [[1,3]]
Explanation: [[3,1]] is also accepted.
Example 2:

Input: n = 2, connections = [[0,1]]
Output: [[0,1]]
 

Constraints:

2 <= n <= 105
n - 1 <= connections.length <= 105
0 <= ai, bi <= n - 1
ai != bi
There are no repeated connections.




func criticalConnections(n int, connections [][]int) [][]int {
	// Строим граф
	graph := make([][]int, n)
	for _, c := range connections {
		graph[c[0]] = append(graph[c[0]], c[1])
		graph[c[1]] = append(graph[c[1]], c[0])
	}

	disc := make([]int, n)   // время открытия вершины
	low := make([]int, n)    // минимальное время достижения
	visited := make([]bool, n)
	time := 0

	var result [][]int

	var dfs func(u, parent int)
	dfs = func(u, parent int) {
		visited[u] = true
		disc[u] = time
		low[u] = time
		time++

		for _, v := range graph[u] {
			if v == parent {
				continue
			}
			if !visited[v] {
				dfs(v, u)
				if low[v] < low[u] {
					low[u] = low[v]
				}
				// Мост: v не может достичь u или его предков без ребра (u,v)
				if low[v] > disc[u] {
					result = append(result, []int{u, v})
				}
			} else {
				if disc[v] < low[u] {
					low[u] = disc[v]
				}
			}
		}
	}

	dfs(0, -1)
	return result
}
